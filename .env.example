# Directory for auth state and database (default: ./data)
DATA_DIR=./data

# Web server port (default: 3000)
PORT=3000

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Admin phone number with country code (e.g., +1 234 567-8900)
# Only this user can add the bot to groups
ADMIN_PHONE=

# Admin panel credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
